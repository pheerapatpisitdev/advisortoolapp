  "compilerOptions": {
    "target": "ES2020", "module": "esnext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "lib": ["dom", "dom.iterable", "esnext"],
