# Copy to .env.local.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# SECRET — server only. Supabase dashboard → Project Settings → API keys → service_role.
# The back office authenticates with its own PIN, so this key is how the server reaches the
# database. Never commit it and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Random string that encrypts the AI keys in the database (the name is from the days it
# also signed the back-office session; the back office has had no login since 2026-09-22).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional: the sign-in cookie's own secret, so it can be rotated without touching the keys
# above (2026-10-01). Unset = derived from ADMIN_SESSION_SECRET. To rotate, move the current
# value to SESSION_SECRET_PREVIOUS (still read, never signed with) and set a new one; after a
# leak, leave SESSION_SECRET_PREVIOUS empty so everybody signs in again. src/lib/auth/session.ts
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=

# สมาชิกทั่วไป sign in with Google (2026-10-02). Google Cloud console → APIs & Services →
# Credentials → OAuth client ID (Web application). Authorised redirect URIs:
# https://<production host>/auth/google/callback and http://localhost:3000/auth/google/callback.
# Unset = the member tab's button says it is not set up. src/lib/auth/google.ts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Facebook Messenger — the app that owns the Page connection.
# FB_APP_SECRET also signs the PSID hash and encrypts the stored page token, so changing it
# orphans every stored conversation and the connection has to be made again.
FB_APP_ID=
FB_APP_SECRET=
# a string you choose; Meta echoes it back once, when the webhook is set
FB_VERIFY_TOKEN=
# a Facebook Login for Business configuration listing the three scopes. A business app
# ignores the scopes sent in the URL, so without this the login asks for a name and a
# photo and ends with "you are not an admin of any page".
FB_LOGIN_CONFIG_ID=

# Vercel sends this as a bearer token when it runs the daily ads sync (vercel.json).
# Without it the sync route answers nobody. Generate one the same way as ADMIN_SESSION_SECRET.
CRON_SECRET=

# A SECOND Facebook Login for Business configuration, for the ADS page: ads_read only, with
# no Page assets on it. It must not be the same configuration as FB_LOGIN_CONFIG_ID — every
# business login replaces the whole grant, so a login through the Page configuration revokes
# the Pages left unticked, which has taken the live inbox down before.
FB_ADS_LOGIN_CONFIG_ID=

# A THIRD Facebook Login for Business configuration, for creating ads from Studio.
# ads_management only. It must not be FB_LOGIN_CONFIG_ID or FB_ADS_LOGIN_CONFIG_ID.
# A business login replaces the whole grant, so do not sign in with this config until
# the Studio connect button exists, and never edit the Page or ads_read configurations.
# The value is the configuration ID from the dashboard, not a token. See
# docs/ads-manage-permission.md. No code reads this yet.
FB_ADS_MANAGE_CONFIG_ID=

# Stripe — the Studio wallet's top-ups (docs/superpowers/specs/2026-09-30-studio-wallet-topup-design.md).
# A restricted key (rk_…) with Checkout Sessions: write only. rk_test_ from a sandbox until launch.
STRIPE_SECRET_KEY=
# from `stripe listen` locally, from the Dashboard's webhook endpoint in production
STRIPE_WEBHOOK_SECRET=

# Meta Pixel and Conversions API (docs/pixel-capi-plan.md).
# Pixel id is public. The token is server-only. Test code is temporary: remove it once
# Events Manager shows the events, or every event stays in test mode.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
